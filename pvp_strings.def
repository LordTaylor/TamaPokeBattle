// --- T4.3 (battle, result, badges) goes below; add rows here, never to StrId in i18n.h ---
// Planned keys (texts in spec F.2): WAIT_OPP, REST_NOTE, AUTO_ATTACK, FOE_HIT_FMT, FOE_MISS, QUIT_Q,
// QUIT_STAY, RESULT_DRAW, POINTS_DELTA_FMT, LEVEL_UP_FMT, BADGE_FMT, WAIT_CONFIRM, BADGES_TITLE,
// BADGES_NONE, BLOCKED_SAME_RIVAL, BLOCKED_CLOCK.
// STARTING ("Starting radio") from F.2 is left out on purpose: the radio starts synchronously, no screen shows it.
